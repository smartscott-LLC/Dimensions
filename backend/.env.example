# Polytope Containment Console — Environment Template
# Copy this file to backend/.env and fill in the values

# MongoDB Atlas connection string
# Format: mongodb://user:pass@cluster.mongodb.net/dbname
MONGO_URL=mongodb://user:pass@cluster.mongodb.net/dbname
DB_NAME=DP3

# CORS configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be 64 hex characters (32 bytes)
JWT_SECRET=your-64-char-hex-secret-goes-here

# Admin credentials (change before production!)
ADMIN_EMAIL=admin@polytope.console
ADMIN_PASSWORD=ChangeMe#123!

# AI Model Configuration (OpenAI-compatible API)
MODEL_API_KEY=sk-your-api-key-here
MODEL_API_URL=https://api.example.com/v1
MODEL_NAME=agnes-2.5-flash

# Supabase Configuration (optional — for hybrid auth)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_JWKS_URL=https://xxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=sb_secret_xxx
